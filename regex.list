# ---- Yahoo / Match / Tracking ----
^https?:([A-Za-z0-9.-]*\.)?clicks\.beap(\.bc\.yahoo(\.\w{2}\.\w{2}|\.\w{2,4})?)$
^https?:([A-Za-z0-9.-]*\.)?secure\.footprint\.net$
^https?://([A-Za-z0-9.-]*\.)?match\.com$
^https?:([A-Za-z0-9.-]*\.)?sitescout(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?appnexus(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?evidon(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?mediamath(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?scorecardresearch(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?doubleclick(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?flashtalking(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?turn(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?mathtag(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?googlesyndication(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?s\.yimg\.com$
^https?:([A-Za-z0-9.-]*\.)?yieldmanager(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?w55c(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?adnxs(\.\w{2}\.\w{2}|\.\w{2,4})$
^https?:([A-Za-z0-9.-]*\.)?advertising\.com$
^https?:([A-Za-z0-9.-]*\.)?surveylink
^https?:([A-Za-z0-9.-]*\.)?info\.yahoo\.com$
^https?:([A-Za-z0-9.-]*\.)?ads\.yahoo\.com$
^https?:([A-Za-z0-9.-]*\.)?global\.ard\.yahoo\.com$
^https?:([a-za-z0-9.]*-)?mtalk\.google\.com$

# ---- Generic Ad / Tracking Patterns ----
^(.+[_.-])?adse?rv(er?|ice)?s?[0-9]*[_.-]
^(.+[_.-])?telemetry[_.-]
^adim(age|g)s?[0-9]*[_.-]
^adtrack(er|ing)?[0-9]*[_.-]
^advert(s|is(ing|ements?))?[0-9]*[_.-]
^aff(iliat(es?|ion))?[_.-]
^analytics?[_.-]
^banners?[_.-]
^beacons?[0-9]*[_.-]
^count(ers?)?[0-9]*[_.-]
^stat(s|istics)?[0-9]*[_.-]
^mads\.
^pixels?[-.]
^telemetry\.
^metric\.
^analytic\.
^adchoice\.
^adsdk\.
^adserv\.
^tracking\.
^traff(ic)?\.
^wpad\.

# ---- Top-Level Domains / Generic Endings ----
(\.cn|\.ru|\.su|\.co|\.vn|\.top|\.porn|\.sex|\.xxx|\.sexy|\.webcam|\.cam|\.tube|\.adult|\.gay|\.casino|\.bet|\.poker|\.link)$
^.+\.(accountant|biz|bid|christmas|click|country|cricket|date|download|faith|gdn|gq|kim|life|loan|world|xin|xyz|zip|link|men|mom|ninja|pro|racing|realtor|science|space|stream|top|win|work|ru|cn|ro|ml|ga|cf|tk|pw|ua|ug|ve|info|site|club|host|party|in|hosting|online|cc|sh|pl|network|la|me|bg|br|website|live|id|cash|za|red|ltd|cloud|ae|trade|name|store|love|luxe|realestate)$

# ---- Googlevideo / YouTube ----
^r[0-9-]+---?sn-[a-z0-9-]+.*\.googlevideo\.com$

# ---- Microsoft / CDN / Watson ----
^(.+\.)?(.*v10.+|.*watson\.|.*vortex\.|1drv|llnw|.*win.+|\.ms.+|.*a\.microsoft.+)\.(com|net)$

